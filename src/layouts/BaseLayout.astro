---
const { title = "Hyunho Kim" } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #0b1020;
        --card: #121a30;
        --text: #e8ecf3;
        --muted: #9aa4b2;
        --line: #24304a;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px;
      }

      header {
        border-bottom: 1px solid var(--line);
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      .brand {
        font-weight: 700;
        font-size: 1.1rem;
      }

      .nav-links {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
      }

      main {
        padding: 48px 0;
      }

      .hero {
        padding: 48px 0 24px;
      }

      .hero h1 {
        margin: 0 0 12px;
        font-size: 2.4rem;
      }

      .hero p {
        margin: 0;
        color: var(--muted);
        max-width: 760px;
      }

      .section {
        margin-top: 48px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 20px;
      }

      .muted {
        color: var(--muted);
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }

      .tag {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 6px 10px;
        color: var(--muted);
        font-size: 0.9rem;
      }

      footer {
        border-top: 1px solid var(--line);
        color: var(--muted);
        padding: 24px 0 48px;
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Hyunho Kim</a>
          <div class="nav-links">
            <a href="/">Home</a>
            <a href="/projects/">Projects</a>
            <a href="/blog/">Blog</a>
            <a href="/about/">About</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer>
      <div class="container">
        © 2026 Hyunho Kim. Built with Astro.
      </div>
    </footer>
  </body>
</html>